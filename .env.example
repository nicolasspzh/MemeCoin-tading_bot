# Copy to .env; process environment variables take precedence.
MODE=PAPER
DB_PATH=runtime/paper.sqlite3
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Verify any replacement with: python -m collectors.rpc_check
# Store credential-bearing URLs only in ignored .env or secure environment settings.
SOLANA_RPC_FALLBACK_URLS=https://solana-rpc.publicnode.com
RPC_CACHE_SECONDS=60
DEX_BASE_URL=https://api.dexscreener.com
POLL_SECONDS=20
MAX_WATCH_TOKENS=30
POOL_DISCOVERY_ENABLED=true
DISCOVERY_POLL_SECONDS=20
DISCOVERY_PAGE_SIZE=20
DISCOVERY_PAGES_PER_POLL=2
DISCOVERY_TRANSACTIONS_PER_POLL=10
# Optional comma-separated Solana mint addresses; no private keys.
WATCH_TOKENS=
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_5M_USD=1000
MAX_TOP10_ACCOUNT_FRACTION=0.60
REQUIRE_VERIFIED_HOLDER_RISK=true
MAX_TOP10_OWNER_FRACTION=0.60
MAX_CREATOR_OBSERVED_FRACTION=0.10
MIN_LP_NONREDEEMABLE_FRACTION=0.90
FEE_BPS=30
SLIPPAGE_BPS=100
FIXED_FEE_USD=0.02
# Paper-only execution assumptions; later observed quote required even at latency 0.
PAPER_LATENCY_SECONDS=1
PAPER_ORDER_TTL_SECONDS=120
PAPER_PRIORITY_FEE_USD=0.005
PAPER_FAILURE_PROBABILITY=0.02
PAPER_MAX_ADVERSE_MOVE_BPS=1000
PAPER_SEED=7
